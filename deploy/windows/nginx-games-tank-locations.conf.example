# 放进 hbycrj.com 已有的 server 块，位置在通用的 location ^~ /games/ 之前。
# Node 仍运行在 127.0.0.1:8080，与 /tank/ 入口共用同一个服务；NGINX 负责剥离 /games/tank/ 前缀。
location = /games/tank {
    # 补上结尾斜杠并保留房间查询参数。
    return 301 /games/tank/$is_args$args;
}

location = /games/tank/ws {
    # 后端只接收 /ws，不能把 /games/tank/ws 原样传给 Node。
    proxy_pass http://127.0.0.1:8080/ws;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    # Node 校验 Origin 与 Host 一致，这里传当前访问的域名。
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
}

location ^~ /games/tank/ {
    # 末尾的 / 必须保留：将 /games/tank/js/main.js 转成后端 /js/main.js。
    proxy_pass http://127.0.0.1:8080/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Connection "";
    # 游戏文件名不带 hash，每次向服务器确认是否有新版本。
    add_header Cache-Control "no-cache" always;
    add_header Strict-Transport-Security "max-age=86400" always;
    add_header X-Content-Type-Options "nosniff" always;
}
